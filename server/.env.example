# --- Postgres (Neon) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`)
ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# --- Email OTP login (Resend) ---
# Resend dashboard → API Keys → Create API Key. Backend-only, never sent to the frontend.
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain/sender verified in Resend (Resend dashboard → Domains).
RESEND_FROM_EMAIL=login@your-verified-domain.com

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=nexforge-files

# --- Project images (server/src/lib/storage/) ---
# Max upload size in MB per cover/gallery image (server-side hard cap).
IMAGE_MAX_SIZE_MB=5
# 'local-dev' (default) uses this server's own local disk — fine for
# development, but production uploads are refused (503) unless this is set
# to 's3' or 'r2' with a matching implementation wired up. See docs/DEPLOYMENT.md.
STORAGE_BACKEND=local-dev

# --- Server ---
PORT=4000
# Vercel deployment origin, no trailing slash
CORS_ORIGIN=https://your-app.vercel.app
