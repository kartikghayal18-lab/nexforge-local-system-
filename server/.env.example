# --- Postgres (Neon) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`)
ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# --- Email OTP login (Resend) ---
# Resend dashboard → API Keys → Create API Key. Backend-only, never sent to the frontend.
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain/sender verified in Resend (Resend dashboard → Domains).
RESEND_FROM_EMAIL=login@your-verified-domain.com

# --- Cloudinary (file/image storage — project images, project files, business logo) ---
# Cloudinary dashboard (cloudinary.com/console) → Account Details.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Project images (server/src/lib/storage/) ---
# Max upload size in MB per cover/gallery image (server-side hard cap).
IMAGE_MAX_SIZE_MB=5

# --- Project files/documents (server/src/routes/files.js) ---
# Max upload size in MB per generic project file (server-side hard cap).
FILE_MAX_SIZE_MB=20

# --- Server ---
PORT=4000
# Vercel deployment origin, no trailing slash
CORS_ORIGIN=https://your-app.vercel.app
